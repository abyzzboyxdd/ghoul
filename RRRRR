#!/bin/bash

# Проверка прав root
if [ "$EUID" -ne 0 ]; then
  echo "Пожалуйста, запустите скрипт от имени root (sudo)."
  exit
fi

echo "=== 1. Обновление системы и установка репозиториев ==="
yum update -y
yum install -y epel-release yum-utils

echo "=== 2. Установка HTTPD, MariaDB и PHP 7.4 (для CentOS 7) ==="
# Установка PHP 7.4 из репозитория Remi, так как в стандартах CentOS 7 идет старый PHP 5.4
yum install -y http://rpms.remirepo.net/enterprise/remi-release-7.rpm
yum-config-manager --enable remi-php74
yum install -y httpd mariadb-server mariadb php php-mysqlnd php-gd php-xml php-mbstring wget unzip samba samba-client

# Запуск сервисов
systemctl enable --now httpd mariadb smb nmb

echo "=== 3. Настройка базы данных MariaDB для WordPress ==="
# Создание БД и пользователя
mysql -e "CREATE DATABASE wordpress_db;"
mysql -e "CREATE USER 'wp_user'@'localhost' IDENTIFIED BY 'Password123!';"
mysql -e "GRANT ALL PRIVILEGES ON wordpress_db.* TO 'wp_user'@'localhost';"
mysql -e "FLUSH PRIVILEGES;"

echo "=== 4. Установка WordPress ==="
wget https://wordpress.org/latest.tar.gz -P /tmp
tar -xzf /tmp/latest.tar.gz -C /var/www/html/
chown -R apache:apache /var/www/html/wordpress
chmod -R 755 /var/www/html/wordpress

# Создание базового wp-config.php
cp /var/www/html/wordpress/wp-config-sample.php /var/www/html/wordpress/wp-config.php
sed -i 's/database_name_here/wordpress_db/' /var/www/html/wordpress/wp-config.php
sed -i 's/username_here/wp_user/' /var/www/html/wordpress/wp-config.php
sed -i 's/password_here/Password123!/' /var/www/html/wordpress/wp-config.php

echo "=== 5. Установка Grafana ==="
cat <<EOF > /etc/yum.repos.get/grafana.repo
[grafana]
name=grafana
baseurl=https://packages.grafana.com/oss/rpm
repo_gpgcheck=1
enabled=1
gpgcheck=1
gpgkey=https://packages.grafana.com/gpg.key
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
EOF

yum install -y grafana
systemctl enable --now grafana-server

echo "=== 6. Настройка SAMBA доступа ==="
mkdir -p /share
chmod 777 /share
cat <<EOF >> /etc/samba/smb.conf

[wp-share]
   comment = WordPress Files
   path = /var/www/html/wordpress
   writable = yes
   guest ok = yes
   browseable = yes
   create mask = 0755
   directory mask = 0755
EOF
systemctl restart smb

echo "=== Настройка брандмауэра (Firewall) ==="
firewall-cmd --permanent --add-service={http,https,samba}
firewall-cmd --permanent --add-port=3000/tcp # Порт Grafana
firewall-cmd --reload

echo "Установка завершена!"
echo "WordPress доступен по адресу: http://your_ip/wordpress"
echo "Grafana доступна по адресу: http://your_ip:3000 (логин/пароль: admin/admin)"
